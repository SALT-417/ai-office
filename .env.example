# ローカルOllamaのチャットAPI URL
OLLAMA_CHAT_URL=http://127.0.0.1:11434/api/chat

# レンが使用するローカルモデル
OLLAMA_MODEL=qwen2.5:3b

# Ollama応答待ち時間（ミリ秒、1000〜120000）
OLLAMA_TIMEOUT_MS=30000

# 専門社員による作業全体の制限時間（ミリ秒、5000〜300000）
WORK_TIMEOUT_MS=90000

# 読み取り専用プロジェクト分析の制限時間（ミリ秒、5000〜180000）
ANALYSIS_TIMEOUT_MS=60000

# ローカルExpress APIのポート（1024〜65535）
AI_OFFICE_API_PORT=8787

# フロントエンド実行モード（秘密情報ではありません）
# npm run dev は未指定でも local-ai、公開ビルドは public-demo が安全な初期値です。
VITE_APP_RUNTIME_MODE=local-ai

# ローカルObsidian Vault保存先（未設定ならVault保存APIは無効）
OBSIDIAN_VAULT_DIR=

# Vault内のMarkdown保存先。空文字ならVault直下、未指定時はAI OFFICE
OBSIDIAN_EXPORT_SUBDIR=AI OFFICE
